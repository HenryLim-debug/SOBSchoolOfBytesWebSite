<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SOBSchoolOfBytesWebSite.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SOB School of Bytes</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link runat="server" href="~/Content/sob-theme.css?v=20261028-dashboard-colours" rel="stylesheet" />
    <link runat="server" href="~/Images/sob-logo.png?v=20261023-logo" rel="icon" type="image/png" />

</head>
<body class="sob-site">
    <a class="sob-skip-link" href="#main-content">Skip to main content</a>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg navbar-light sob-navbar" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand sob-brand" runat="server" href="~/" aria-label="SOB School of Bytes home"><img runat="server" src="~/Images/sob-logo.png?v=20261023-logo" alt="SOB School of Bytes" width="928" height="727" /></a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#sobNavigation" title="Toggle navigation" aria-controls="sobNavigation"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="sobNavigation" class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item"><a ID="HomeNav" class="nav-link" runat="server" href="~/">Home</a></li>
                        <li class="nav-item"><a ID="CoursesNav" class="nav-link" runat="server" href="~/CourseCatalogue">Courses</a></li>
                        <li class="nav-item"><a ID="AboutNav" class="nav-link" runat="server" href="~/About">About</a></li>
                        <li class="nav-item"><a ID="ContactNav" class="nav-link" runat="server" href="~/Contact">Contact</a></li>
                        <li ID="RegisterNavItem" class="nav-item" runat="server"><a ID="RegisterNav" class="nav-link" runat="server" href="~/StudentRegistration">Register</a></li>
                        <li ID="LoginNavItem" class="nav-item" runat="server"><a ID="LoginNav" class="nav-link sob-nav-action" runat="server" href="~/Login">Login</a></li>
                        <li ID="DashboardNavItem" class="nav-item" runat="server" Visible="false"><a ID="DashboardNav" class="nav-link sob-nav-action" runat="server">My Dashboard</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <div id="main-content" class="container body-content" tabindex="-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <footer class="sob-footer">
            <div class="container sob-footer-inner">
                <div><strong>SOB School of Bytes</strong><p class="mb-0">Discover. Create. Learn together.</p></div>
                <nav aria-label="Footer navigation"><a runat="server" href="~/CourseCatalogue">Courses</a><a runat="server" href="~/About">About</a><a runat="server" href="~/Contact">Contact</a></nav>
                <small>&copy; <%: DateTime.UtcNow.AddHours(8).Year %> SOB School of Bytes</small>
            </div>
        </footer>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
